NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
MAILGUN_API_KEY=your-mailgun-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
CRON_SECRET=your-cron-secret
# Optional — base URL for email logo/footer links (defaults to https://thelitlyapp.com)
# NEXT_PUBLIC_APP_URL=
# Optional — Ed25519 private JWK for the URL importer's Web Bot Auth signatures
# (generate: node scripts/generate-web-bot-auth-key.js). Unset = unsigned requests.
# WEB_BOT_AUTH_PRIVATE_KEY={"crv":"Ed25519","d":"...","x":"...","kty":"OKP"}
